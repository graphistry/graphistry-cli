# Optional settings for ubuntu_26_04_setup.sh. Copy to `.env` next to the script
# (or export them) to override. Every value below is the script's default.
#
# Note: the script turns OFF automatic security updates (unattended-upgrades removed,
# apt-daily timers and APT::Periodic disabled) so the driver, kernel and Docker never
# change under a running GPU server. Patch in a maintenance window with
# `sudo apt-get update && sudo apt-get dist-upgrade && sudo reboot`. The script header
# shows how to turn automatic updates back on.

# Linux user that owns and runs Graphistry (gets added to the docker group)
GRAPHISTRY_USER=ubuntu

# Where the Graphistry release tarball is unpacked
GRAPHISTRY_HOME=/home/ubuntu/graphistry

# Nvidia driver source. Pick by whether the host boots with Secure Boot on
# (check with `mokutil --sb-state`).
#
# SECURE_BOOT=0 (default): Nvidia's own CUDA apt repo, exact version pinned
#   - Installs exactly NVIDIA_DRIVER_VERSION and holds every driver package at it
#     (nvidia-driver-pinning-<version>); `apt dist-upgrade` will not move it.
#   - The kernel module is compiled on the host by DKMS (needs build tools and kernel
#     headers, both installed) and rebuilt automatically for each new kernel.
#   - The module is not signed by Canonical, so it will NOT load with Secure Boot on.
#     The script stops if Secure Boot is on, unless ALLOW_SECURE_BOOT_MOK=1 and
#     someone can enroll a MOK key at the physical/virtual console during the reboot.
#   - Choose this when the exact driver version is a requirement and Secure Boot is
#     off (most cloud VMs, including AWS Ubuntu AMIs).
#
# SECURE_BOOT=1: Ubuntu's own <branch>-server driver with Canonical-signed modules
#   - Installs Ubuntu's NVIDIA_UBUNTU_BRANCH driver (595-server, currently 595.91.07)
#     and the prebuilt linux-modules-nvidia-<branch> package for the running kernel
#     flavour (generic, HWE, aws, azure, gcp, oracle). No compiler, no DKMS.
#   - Modules are signed by Canonical, so they load with Secure Boot on, no console step.
#   - Ubuntu ships newer point releases within the branch alongside kernel updates, so
#     after a future `apt dist-upgrade` the version can move (e.g. 595.91.07 to 595.9x).
#     The script warns if the installed version differs from NVIDIA_DRIVER_VERSION.
#   - Choose this for hosts that must keep Secure Boot on (common on hardened or
#     government on-prem servers).
#
# Pick before the first run: switching on an installed host is not supported.
SECURE_BOOT=0

# Driver version: exact pin with SECURE_BOOT=0, expected version with SECURE_BOOT=1
NVIDIA_DRIVER_VERSION=595.91.07

# open (Turing / T4 and newer) or proprietary (needed for Pascal / Volta)
NVIDIA_KERNEL_MODULES=open

# Ubuntu driver branch for SECURE_BOOT=1 (default: <major of NVIDIA_DRIVER_VERSION>-server)
NVIDIA_UBUNTU_BRANCH=595-server

# Nvidia CUDA apt repo for the driver (SECURE_BOOT=0)
NVIDIA_REPO=https://developer.download.nvidia.com/compute/cuda/repos/ubuntu2604/x86_64

# SECURE_BOOT=0 only: 1 = continue with Secure Boot on (unsigned DKMS module; enroll the
# MOK key at the console)
ALLOW_SECURE_BOOT_MOK=0

# Small image used only to verify `nvidia-smi` works inside Docker
NVIDIA_CONTAINER=nvidia/cuda:12.8.1-base-ubuntu24.04

# Pin Docker, e.g. 5:29.9.1-1~ubuntu.26.04~resolute (empty = latest; list versions with
# `apt-cache madison docker-ce`)
DOCKER_VERSION=

# false = classic overlay2 image store (same as 22.04 hosts); true = Docker 29+ containerd store
DOCKER_CONTAINERD_SNAPSHOTTER=false

# Docker log size limit per container (json-file driver). Empty = Docker's default,
# which never rotates, so logs of long-running Graphistry services grow until the disk
# fills. Suggested: 100m. Applies to containers created after the change.
DOCKER_LOG_MAX_SIZE=
# Number of rotated log files kept per container when DOCKER_LOG_MAX_SIZE is set
DOCKER_LOG_MAX_FILE=3

# 1 = fail without an Nvidia GPU and run GPU container checks; 0 = for GPU-less test VMs
REQUIRE_GPU=1

# 1 = stop and disable snapd
DISABLE_SNAPD=1

# systemd-resolved FallbackDNS, only used when no other DNS is configured (empty = skip)
FALLBACK_DNS="8.8.8.8 8.8.4.4"

# 1 = reboot automatically at the end of stage 1, after REBOOT_DELAY seconds
AUTO_REBOOT=1
REBOOT_DELAY=30

# Breadcrumb marking stage 1 as done
LOCK_FILE=/home/ubuntu/g-part1.lck
